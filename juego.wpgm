import wollok.game.*
import objetos.*
import configuracion.*
import habitaciones.*


program NombreDeJuego {
	game.title("Grupo: Ctrl_z | Escapando del Chiqui Tapia")
	game.height(15)
	game.width(15)
	


	(0..14).forEach({ x =>
		game.addVisual(new Muro(position = game.at(x, 0)))
		game.addVisual(new Muro(position = game.at(x, 14)))
	})
	
	
	(1..13).forEach({ y =>
		game.addVisual(new Muro(position = game.at(0, y)))
		game.addVisual(new Muro(position = game.at(14, y)))
	})

	
	player.position(game.at(1, 1))
	game.addVisual(player)

		const mate = new Item(
        nombre = "mate", 
        image = "mate.png", 
        position = game.at(5, 5)
    )
    game.addVisual(mate)

	const riquelme = new NPC(
        itemDeseado = "mate", 
        image = "riquelme.png", 
        position = game.at(8, 8)
    )
    game.addVisual(riquelme)

	const fotoDeMessi = new Item(
    nombre = "foto de messi",
    image = "foto_messi.png",
    position = game.at(3, 3) 
	)  
	game.addVisual(fotoDeMessi) 

	const dePaul = new NPC(
    itemDeseado = "foto de messi",
    image = "depaul.png",     
    position = game.at(10, 10) 
	) 
	game.addVisual(dePaul)

	const puerta = new Puerta(
        position = game.at(13, 13),
        npcsCondicion = [riquelme, dePaul]
    )
    game.addVisual(puerta)

	configuracion.configurarAcciones()

	game.start()

}
