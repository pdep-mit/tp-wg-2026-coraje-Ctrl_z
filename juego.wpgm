import wollok.game.*
import objetos.*
import configuracion.*
import habitaciones.*


program NombreDeJuego {
    game.title("Grupo: Ctrl_z | Escapando del Chiqui Tapia")
    game.height(15)
    game.width(15)

    player.position(game.at(1, 1))
    game.addVisual(player)

    niveles.iniciar()

    configuracion.configurarAcciones()

    game.start()
}
